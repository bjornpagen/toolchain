{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": [
		"packages/devtools/src/oxlint/fixtures.config.ts",
		"packages/testing/src/vitest/coverage.ts",
		"packages/testing/src/vitest/mutated-setup.ts",
		"packages/testing/src/vitest/searches-setup.ts",
		"packages/testing/src/witness.fixtures.ts"
	],
	// out/ is where a proof run builds a consumer, with a pnpm workspace of its own: not this repository's code.
	"ignorePatterns": ["packages/devtools/src/*/fixtures/**", "out/**"],
	// The dev tools' fixtures, which fallow does not read, are these packages' only importers: Drizzle and pg for the
	// SQL rules, @effect/vitest's declarations for the test rules, React's types for the React Compiler's and the style
	// linter's, and Tailwind for the style linter's. The tsconfigs' @effect/language-service plugin is no package: it is
	// @effect/tsgo's, patched into TypeScript.
	"ignoreDependencies": [
		"@effect/language-service",
		"@effect/vitest",
		"@types/react",
		"drizzle-orm",
		"pg",
		"tailwindcss"
	],
	"rules": {
		"require-suppression-reason": "error"
	},
	"boundaries": {
		"zones": [
			{
				"name": "devtools-suites",
				"patterns": ["packages/devtools/src/**/*.test.ts", "packages/devtools/vitest.config.ts"]
			},
			{
				"name": "testing",
				"patterns": ["packages/testing/**"]
			},
			{
				"name": "devtools",
				"patterns": ["packages/devtools/**"]
			},
			{
				"name": "configs",
				"patterns": ["oxlint.config.ts", "toolchain.config.ts"]
			}
		],
		"rules": [
			{
				"from": "devtools-suites",
				"allow": ["devtools", "testing"]
			},
			{
				"from": "testing",
				"allow": []
			},
			{
				"from": "devtools",
				"allow": []
			},
			{
				"from": "configs",
				"allow": ["devtools", "testing"]
			}
		],
		"coverage": {
			"requireAllFiles": true
		}
	}
}
