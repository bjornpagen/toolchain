{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": [
		"oxlint.ast.config.ts",
		"packages/devtools/src/oxlint/fixtures.config.ts",
		"packages/devtools/src/style/classes.config.ts",
		"packages/testing/src/mutate/hook.ts",
		"packages/testing/src/mutate/templates.fixtures.ts",
		"packages/testing/src/pg/cli.ts",
		"packages/testing/src/runner/cli-entry.ts",
		"packages/testing/src/runner/loops.fixtures.ts",
		"packages/testing/src/runner/orphans.fixtures.ts",
		"packages/testing/src/runner/pool.fixtures.ts",
		"packages/testing/src/runner/worker-entry.ts",
		"packages/testing/src/vitest/compile-cache.ts",
		"packages/testing/src/vitest/coverage.ts",
		"packages/testing/src/vitest/searches-setup.ts",
		"packages/testing/src/witness.fixtures.ts",
		"packages/testing/test.config.ts",
		"packages/devtools/test.config.ts"
	],
	// out/ is where a proof run builds a consumer, with a pnpm workspace of its own: not this repository's code.
	"ignorePatterns": ["packages/devtools/src/*/fixtures/**", "out/**"],
	// The dev tools' fixtures, which fallow does not read, are these packages' only importers: Drizzle for the SQL
	// rules, @effect/vitest's declarations for the test rules, React's types for the oxlint plugin's TSX, and
	// Tailwind for the class rules', which resolve it from their fixtures. The tsconfigs' @effect/language-service
	// plugin is no package: it is @effect/tsgo's, patched into TypeScript.
	"ignoreDependencies": [
		"@effect/language-service",
		"@effect/vitest",
		"@types/react",
		"drizzle-orm",
		"tailwindcss"
	],
	"rules": {
		"require-suppression-reason": "error"
	},
	"boundaries": {
		"zones": [
			{
				"name": "devtools-suites",
				"patterns": [
					"packages/devtools/src/**/*.test.ts",
					"packages/devtools/src/**/*.fixtures.ts",
					"packages/devtools/test.config.ts"
				]
			},
			{
				"name": "testing",
				"patterns": ["packages/testing/**"]
			},
			{
				"name": "devtools",
				"patterns": ["packages/devtools/**"]
			},
			{
				"name": "configs",
				"patterns": ["oxlint.config.ts", "oxlint.ast.config.ts", "toolchain.config.ts"]
			}
		],
		"rules": [
			{
				"from": "devtools-suites",
				"allow": ["devtools", "testing"]
			},
			{
				"from": "testing",
				"allow": []
			},
			{
				"from": "devtools",
				"allow": []
			},
			{
				"from": "configs",
				"allow": ["devtools", "testing"]
			}
		],
		"coverage": {
			"requireAllFiles": true
		}
	}
}
