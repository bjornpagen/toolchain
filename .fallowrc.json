{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": [
		"oxlint.ast.config.ts",
		"packages/devtools/src/land.ts",
		"packages/devtools/src/oxlint/fixtures.config.ts",
		"packages/devtools/src/style/classes.config.ts",
		"packages/testing/src/mutate/hook.ts",
		"packages/testing/src/mutate/templates.fixtures.ts",
		"packages/testing/src/pg/cli.ts",
		"packages/testing/src/resources/cluster.fixtures.ts",
		"packages/testing/src/runner/cli-entry.ts",
		"packages/testing/src/runner/load-entry.ts",
		"packages/testing/src/runner/loops.fixtures.ts",
		"packages/testing/src/runner/nested.fixtures.ts",
		"packages/testing/src/runner/orphans.fixtures.ts",
		"packages/testing/src/runner/pool.fixtures.ts",
		"packages/testing/src/runner/worker-entry.ts",
		"packages/testing/src/vitest/compile-cache.ts",
		"packages/testing/src/vitest/coverage.ts",
		"packages/testing/src/vitest/searches-setup.ts",
		"packages/testing/src/witness.fixtures.ts",
		"packages/testing/test.config.ts",
		"packages/devtools/test.config.ts"
	],
	// out/ is where a proof run builds a consumer, with a pnpm workspace of its own: not this repository's code.
	"ignorePatterns": ["packages/devtools/src/*/fixtures/**", "out/**"],
	// The dev tools' fixtures, which fallow does not read, are these packages' only importers: Drizzle for the SQL
	// rules, @effect/vitest's declarations for the test rules, React's types for the oxlint plugin's TSX, and
	// Tailwind for the class rules', which resolve it from their fixtures. The tsconfigs' @effect/language-service
	// plugin is no package: it is @effect/tsgo's, patched into TypeScript.
	"ignoreDependencies": [
		"@effect/language-service",
		"@effect/vitest",
		"@types/react",
		"drizzle-orm",
		"tailwindcss"
	],
	"rules": {
		"require-suppression-reason": "error"
	},
	"boundaries": {
		"zones": [
			// The testing library's oxlint plugin, its rules and the rule sets every configuration holds: the dev tools'
			// preset loads it and holds its rules wherever a repository installs the library, so no configuration names
			// the plugin or its rules itself (the core lint set), and so the preset may import it.
			{
				"name": "testing-lint",
				"patterns": ["packages/testing/src/oxlint/plugin.ts"]
			},
			// Test scope (what a test module and its support are), one definition the dev tools' lint scopes and the
			// testing library's census read, so it is a zone of its own that both packages may import.
			{
				"name": "scope",
				"patterns": ["packages/testing/src/scope.ts"]
			},
			// The machine's width (testWorkers, and each gate tool's share of it, threadsPerTask), one definition the
			// testing library's runner and the dev tools' wrappers of the gate's tools read, so a zone of its own too.
			{
				"name": "width",
				"patterns": ["packages/testing/src/workers.ts"]
			},
			// The toolchain's caches on disk (toolchain-test's cache and Node's compile cache under it), one definition the
			// testing library's runner and the dev tools' toolchain-turbo read, so a zone of its own too.
			{
				"name": "caches",
				"patterns": [
					"packages/testing/src/runner/cache-home.ts",
					"packages/testing/src/runner/compile-cache.ts"
				]
			},
			{
				"name": "devtools-suites",
				"patterns": [
					"packages/devtools/src/**/*.test.ts",
					"packages/devtools/src/**/*.fixtures.ts",
					"packages/devtools/test.config.ts"
				]
			},
			{
				"name": "testing",
				"patterns": ["packages/testing/**"]
			},
			{
				"name": "devtools",
				"patterns": ["packages/devtools/**"]
			},
			{
				"name": "configs",
				"patterns": ["oxlint.config.ts", "oxlint.ast.config.ts", "toolchain.config.ts"]
			}
		],
		"rules": [
			{
				"from": "devtools-suites",
				"allow": ["devtools", "testing", "width", "testing-lint"]
			},
			{
				"from": "testing",
				"allow": ["scope", "width", "caches", "testing-lint"]
			},
			{
				"from": "devtools",
				"allow": ["scope", "width", "caches", "testing-lint"]
			},
			{
				"from": "testing-lint",
				"allow": ["testing"]
			},
			{
				"from": "configs",
				"allow": ["devtools", "testing", "testing-lint"]
			}
		],
		"coverage": {
			"requireAllFiles": true
		}
	}
}
