{
	"name": "toolchain",
	"private": true,
	"type": "module",
	"imports": {
		"#oxlint.config.ts": "./oxlint.config.ts",
		"#package.json": "./package.json",
		"#toolchain.config.ts": "./toolchain.config.ts"
	},
	"packageManager": "pnpm@12.21.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26",
			"onFail": "error"
		}
	},
	"scripts": {
		"prepare": "effect-tsgo patch",
		"check": "turbo run typecheck --continue=dependencies-successful -- --incremental false; typecheck=$?; turbo run oxlint format dead-code dedupe workspace-gate fixtures:style fixtures:oxlint fixtures:workspace-gate load --continue=dependencies-successful && exit $typecheck",
		"types": "turbo run typecheck",
		"typecheck": "toolchain-typecheck",
		"workspace-gate": "workspace-gate",
		"oxlint": "toolchain-oxlint-root",
		"format": "oxfmt --check .",
		"format:write": "oxfmt .",
		"dead-code": "fallow dead-code",
		"dedupe": "pnpm dedupe --check",
		"fuzz": "node packages/testing/scripts/fuzz.ts",
		"land": "sh packages/devtools/bin/land.sh",
		"test": "turbo run test"
	},
	"devDependencies": {
		"@bjornpagen/devtools": "workspace:*",
		"@bjornpagen/testing": "workspace:*",
		"@effect/tsgo": "catalog:",
		"@effect/vitest": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"@types/react": "catalog:",
		"drizzle-orm": "catalog:",
		"fallow": "catalog:",
		"lefthook": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"pg": "catalog:",
		"tailwindcss": "catalog:",
		"tsrs": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
