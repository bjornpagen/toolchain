{
	"name": "@bjornpagen/devtools",
	"private": true,
	"description": "The dev tools every repository shares: the oxlint preset and plugin (every lint rule, each reading syntax alone, with each Tailwind app's class rules through eslint-plugin-better-tailwindcss and oxlint's React Compiler rules), the Tailwind stylesheet linter (superstyle, which reads files as text), the workspace gate (the repository-wide tsconfig, manifest and file-name checks), the tsconfig bases and the hook, typecheck and oxlint commands, each proven against fixtures; no check opens a TypeScript program but the typecheck. A repository takes it from GitHub by commit and keeps its own decisions in toolchain.config.ts.",
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"exports": {
		"./config": "./src/config.ts",
		"./devtool": "./src/shared/devtool.ts",
		"./native-api": "./src/shared/native-api.ts",
		"./oxlint/fixtures": "./src/oxlint/prove.ts",
		"./oxlint/rule": "./src/oxlint/rule.ts",
		"./oxlint/syntax": "./src/oxlint/syntax.ts",
		"./preset": "./src/preset.ts",
		"./react-compiler": "./src/react-compiler/options.ts",
		"./run": "./src/shared/run.ts",
		"./style": "./src/style/own.ts",
		"./tsconfig.base.json": "./tsconfig.base.json",
		"./tsconfig.effect-free.json": "./tsconfig.effect-free.json"
	},
	"bin": {
		"toolchain-gate": "./bin/gate.sh",
		"toolchain-oxlint": "./bin/oxlint.sh",
		"toolchain-oxlint-root": "./src/oxlint-root.ts",
		"toolchain-typecheck": "./bin/typecheck.sh",
		"superstyle": "./src/style.ts",
		"workspace-gate": "./src/workspace-gate.ts"
	},
	"scripts": {
		"typecheck": "toolchain-typecheck",
		"typecheck:full": "toolchain-typecheck --incremental false",
		"oxlint": "toolchain-oxlint",
		"fixtures:style": "node src/style.ts --fixtures",
		"fixtures:oxlint": "node src/oxlint/fixtures.ts",
		"fixtures:workspace-gate": "node src/workspace-gate.ts --fixtures",
		"test": "toolchain-test run"
	},
	"devDependencies": {
		"@bjornpagen/testing": "workspace:*",
		"@effect/vitest": "catalog:",
		"@types/node": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/tsgo": "catalog:",
		"effect": "catalog:",
		"eslint-plugin-better-tailwindcss": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:"
	}
}
