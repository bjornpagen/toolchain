{
	"name": "@bjornpagen/testing",
	"private": true,
	"description": "A choice-stream testing library on Effect and Vitest: every case is a tape of bounded choices, so one generator is searched at random, enumerated exhaustively, replayed, mutated and shrunk.",
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#package.json": "./package.json",
		"#pg.config.ts": "./pg.config.ts",
		"#codemod/*": "./scripts/codemod/*",
		"#*": "./src/*"
	},
	"exports": {
		"./assert": "./src/assert.ts",
		"./checkout": "./src/mutate/checkout.ts",
		"./compile-cache": "./src/runner/compile-cache.ts",
		"./commands": "./src/commands.ts",
		"./dictionary": "./src/dictionary.ts",
		"./enumerate": "./src/enumerate.ts",
		"./explore": "./src/explore.ts",
		"./failure": "./src/failure.ts",
		"./fuzz": "./src/fuzz.ts",
		"./fact": "./src/fact.ts",
		"./features": "./src/features.ts",
		"./gen": "./src/gen.ts",
		"./inline": "./src/runner/inline.ts",
		"./interleave": "./src/interleave.ts",
		"./live": "./src/live.ts",
		"./mutate": "./src/mutate.ts",
		"./mutants": "./src/mutants.ts",
		"./lsw": "./src/lsw.ts",
		"./oracle": "./src/oracle.ts",
		"./random": "./src/random.ts",
		"./scope": "./src/scope.ts",
		"./sense": "./src/sense.ts",
		"./shrink": "./src/shrink.ts",
		"./source": "./src/source.ts",
		"./swarm": "./src/swarm.ts",
		"./syntax": "./src/syntax.ts",
		"./tape": "./src/tape.ts",
		"./values": "./src/values.ts",
		"./vitest": "./src/vitest/searched.ts",
		"./vitest/config": "./src/vitest/config.ts",
		"./vitest/global-setup": "./src/vitest/global-setup.ts",
		"./vitest/reporter": "./src/vitest/reporter.ts",
		"./vitest/run": "./src/vitest/run.ts",
		"./pattern": "./src/pattern.ts",
		"./pg": "./src/pg/pg.ts",
		"./pg-session": "./src/pg/session.ts",
		"./property": "./src/property.ts",
		"./runner": "./src/runner/config.ts",
		"./resources": "./src/resources/resources.ts",
		"./oxlint": "./src/oxlint/plugin.ts",
		"./workers": "./src/workers.ts",
		"./vitest.config": "./vitest.config.ts"
	},
	"bin": {
		"toolchain-pg": "./scripts/toolchain-pg.sh",
		"toolchain-test": "./scripts/toolchain-test.sh"
	},
	"scripts": {
		"typecheck": "toolchain-typecheck",
		"oxlint": "toolchain-oxlint",
		"load": "toolchain-test load",
		"test": "toolchain-test run",
		"bench": "vitest bench --run",
		"mutate": "toolchain-test mutate",
		"pg": "toolchain-pg",
		"codemod": "node scripts/codemod/main.ts"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/vitest": "catalog:",
		"arkregex": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@types/pg": "catalog:",
		"pg": "catalog:"
	},
	"peerDependencies": {
		"oxlint": "^1.94.0",
		"pg": "^8.23.1",
		"typescript": "^7.1.0-beta",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"peerDependenciesMeta": {
		"oxlint": {
			"optional": true
		},
		"pg": {
			"optional": true
		},
		"typescript": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	}
}
